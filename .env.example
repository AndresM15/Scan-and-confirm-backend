# Copia este archivo a .env (cp .env.example .env). El .env no se sube a git.

# Base de datos local con Docker: npm run db:up
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scan_and_confirm
POSTGRES_PORT=5433

# Debe coincidir con los valores de arriba
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/scan_and_confirm?schema=public"

PORT=3000
